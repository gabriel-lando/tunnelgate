# Cloudflare account API token (Manage Account > Account API Tokens), two policies:
#   Entire account:  Argo Tunnel (Legacy) > Edit   (summary: "Cloudflare Tunnel Write")
#   Specific zones:  DNS > Edit, Zone > Read, Zone WAF > Edit
# Scope the zone policy to the zones you want Tunnelgate to manage.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# OIDC client registered in Authelia.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=tunnelgate
OIDC_CLIENT_SECRET=
# Require multi-factor authentication (checked through the "amr" claim).
OIDC_REQUIRE_MFA=true

# Public URL of the app (no path). Used for the OIDC redirect URI, Origin checks and cookies.
APP_URL=https://tunnelgate.int.example.com

# Comma-separated groups allowed to use the app (case-insensitive).
ALLOWED_GROUPS=HomeAdmins

# Optional: extra hostnames that need confirmation before blocking.
# The OIDC issuer's hostname is always treated as critical.
CRITICAL_HOSTS=

# Optional: where cloned routes may point (comma-separated host or host:port glob patterns).
# Strongly recommended, e.g. "*.lan:*,10.0.10.*,gitea:3000". Loopback, link-local/metadata
# addresses, this app and the OIDC issuer are always refused.
SERVICE_ALLOWLIST=

# Optional: session lifetime in seconds (default 8 hours).
SESSION_MAX_AGE=28800

# Development only (min. 32 characters). Leave unset in production so the key is random per start.
# SESSION_SECRET=
